# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_USER_IDS=111111111,222222222

# Local Python defaults. Docker overrides these to /app paths.
AVIARY_MODEL_PATH=data/server/models/current/bird_detector.pt

# Comma-separated object labels to collect when they alert. Empty disables collection.
COLLECT_OBJECTS=
# Comma-separated object labels allowed to alert. Empty alerts on every detected object.
FILTER_OBJECTS=

# Tapo RTSP URLs, comma-separated. One camera is built per URL, named
# camera-1, camera-2, ... in order (see server/aviary_server/config.py).
# Use Tapo app camera account credentials, not your TP-Link cloud password.
# Example shape per entry:
# rtsp://camera_user:camera_password@192.168.1.50:554/stream1
TAPO_RSTP=rtsp://user:password@192.168.1.50:554/stream1,rtsp://user:password@192.168.1.51:554/stream1,rtsp://user:password@192.168.1.52:554/stream1

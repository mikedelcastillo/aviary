# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_USER_IDS=111111111,222222222

# Local Python defaults. Docker overrides these to /app paths.
# One or more model files, comma-separated. Each model runs a separate pass over
# every frame and their detections are merged.
MODEL_PATH=data/server/models/current/bird_detector.pt,yolo11x.pt

# Detection confidence floor (0..1). Lower = more recall, fewer misses; higher =
# more precision, fewer false alerts. Defaults to 0.5 (the F1 peak) if unset.
MODEL_CONFIDENCE=0.5

# Inference image size in pixels. Higher recovers recall on small/distant birds
# at the cost of slower inference; should match (or exceed) the model's training
# size. Defaults to 960 if unset.
MODEL_IMAGE_SIZE=1280

# Comma-separated object labels to collect when they alert. Empty disables collection.
COLLECT_OBJECTS=
# Comma-separated object labels allowed to alert. Empty alerts on every detected object.
FILTER_OBJECTS=

# Only the Tapo camera-account user:password (the credentials you set in the Tapo
# app, NOT your TP-Link cloud password). Cameras are auto-discovered on the LAN:
# the server sweeps the local subnet for hosts with :554 open and a working
# /stream1, then builds the full RTSP URL per camera at runtime. The scan port and
# stream path are .py config (DiscoveryConfig in server/lib/config.py), not env.
TAPO_CREDENTIALS=user:password

# Optional. Override the subnet that discovery scans, in CIDR form (e.g.
# 192.168.1.0/24). Leave unset to auto-detect the host's primary /24. Set this
# when auto-detect picks the wrong interface — e.g. inside Docker, or on a host
# with multiple subnets.
# TAPO_DISCOVERY_CIDR=192.168.1.0/24

# Immich. BASE_URL must include the /api suffix. API_KEY is comma-separated —
# one key per phone/user; the script downloads each user's "Birds" album.
IMMICH_BASE_URL=http://192.168.1.50:2283/api
IMMICH_API_KEY=replace-me,replace-me

# Ollama (natural-language commands + chat + vision captioning). This project
# NEVER installs or manages Ollama — it only talks to the one already running on
# the machine. Point OLLAMA_BASE_URL at it. The two models default to ones the
# host already has pulled: a language model for intent/chat and a vision model
# for describing bird photos. Set OLLAMA_ENABLED=0 to turn the AI features off.
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://localhost:11434
# Optional: point at an Olla load balancer instead of a single Ollama. Olla is
# an Ollama-compatible proxy that distributes chat/vision calls across several
# machines by priority, so the local 8GB GPU mostly runs YOLO while the VLM/LLM
# run on bigger boxes. Set to Olla's Ollama path (default port 40114).
# OLLA_ENDPOINT takes precedence over OLLAMA_BASE_URL when set.
# OLLA_ENDPOINT=http://localhost:40114/olla/ollama
# With a cluster, raise vision concurrency so calls fan out across machines
# instead of queuing on one (default 1 is for a single GPU):
# OLLAMA_VISION_CONCURRENCY=4
OLLAMA_LLM_MODEL=qwen3:4b
# 3B vision model: on an 8GB GPU the 7B (4.75GB) spilled to CPU once YOLO + the
# LLM were also resident. The 3B (2.16GB) keeps all three on-GPU at the same
# latency and near-identical quality. Use qwen2.5vl:7b only on a bigger GPU.
OLLAMA_VLM_MODEL=qwen2.5vl:3b
# Max concurrent vision (image) calls; extra callers queue. 1 stops the GPU
# being swamped when many frames are captioned/named at once. Raise if your GPU
# can handle parallel vision passes.
OLLAMA_VISION_CONCURRENCY=1

# Caretaker reports: the server checks activity often, reports a NEW bird
# immediately, and on this ~N-minute beat edits the last message in place when
# nothing changed (no spam). Every report is also written to the day's memory
# under data/server/memories/YYYY-MM-DD.md, which /activity and "what did percy
# do today?" read back. 0 disables. When reports are ON, raw per-detection photo
# alerts default OFF (set RAW_PHOTO_ALERTS to force). Detections are still
# collected to disk regardless.
MEMORY_INTERVAL_MINUTES=5
# RAW_PHOTO_ALERTS=0

# /find PTZ patrol scans a grid of each pan-tilt camera's range so it covers the
# tilt (up/down) axis too, not just left-right. Columns x rows = cells visited.
PTZ_SCAN_COLS=4
PTZ_SCAN_ROWS=3

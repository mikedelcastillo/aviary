# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_USER_IDS=111111111,222222222

# Local Python defaults. Docker overrides these to /app paths.
AVIARY_MODEL_PATH=server/models/current/bird_detector.pt
AVIARY_SNAPSHOT_DIR=server/snapshots

# Tapo RTSP URLs. Use Tapo app camera account credentials, not your TP-Link cloud password.
# Example shape:
# rtsp://camera_user:camera_password@192.168.1.50:554/stream1
TAPO_ROOM_MAIN_RTSP=rtsp://user:password@192.168.1.50:554/stream1
TAPO_ROOM_SIDE_RTSP=rtsp://user:password@192.168.1.51:554/stream1
TAPO_ROOM_PERCH_RTSP=rtsp://user:password@192.168.1.52:554/stream1

# Immich
IMMICH_BASE_URL=http://192.168.1.168:2283/api
IMMICH_BIRD_MODEL=yolo11x.pt
IMMICH_BIRD_THRESHOLD=0.30
IMMICH_BIRD_DEVICE=auto
IMMICH_THUMBNAIL_SIZE=preview

# Add one API key per Immich account. Match these env var names in
# models/immich/config/accounts.yaml.
IMMICH_ACCOUNT_1_API_KEY=replace-me
IMMICH_ACCOUNT_2_API_KEY=replace-me

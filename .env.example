# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_USER_IDS=111111111,222222222

# Local Python defaults. Docker overrides these to /app paths.
# One or more model files, comma-separated. Each model runs a separate pass over
# every frame and their detections are merged.
MODEL_PATH=data/server/models/current/bird_detector.pt,yolo11x.pt

# Detection confidence floor (0..1). Lower = more recall, fewer misses; higher =
# more precision, fewer false alerts. Defaults to 0.5 (the F1 peak) if unset.
MODEL_CONFIDENCE=0.5

# Inference image size in pixels. Higher recovers recall on small/distant birds
# at the cost of slower inference; should match (or exceed) the model's training
# size. Defaults to 960 if unset.
MODEL_IMAGE_SIZE=1280

# Comma-separated object labels to collect when they alert. Empty disables collection.
COLLECT_OBJECTS=
# Comma-separated object labels allowed to alert. Empty alerts on every detected object.
FILTER_OBJECTS=

# Privacy screen for OUTBOUND Telegram photos: every image is checked with a
# stock COCO model before upload, and any frame showing a person is withheld
# (the alert/report text still goes out, with a note saying why the photo is
# absent). Applies only to Telegram uploads — local snapshots, collection and
# memory photos are untouched. On by default; PRIVACY_FILTER=0 disables. The
# model must know a 'person' class (the trained bird models don't), and the
# confidence floor is deliberately LOW — recall over precision, since a missed
# person leaks a photo of you while a false positive only holds back one photo.
# PRIVACY_FILTER=1
# PRIVACY_MODEL_PATH=./yolo11n.pt
# PRIVACY_CONFIDENCE=0.25

# Only the Tapo camera-account user:password (the credentials you set in the Tapo
# app, NOT your TP-Link cloud password). Cameras are auto-discovered on the LAN:
# the server sweeps the local subnet for hosts with :554 open and a working
# /stream1, then builds the full RTSP URL per camera at runtime. The scan port and
# stream path are .py config (DiscoveryConfig in server/lib/config.py), not env.
TAPO_CREDENTIALS=user:password

# Optional. Override the subnet that discovery scans, in CIDR form (e.g.
# 192.168.1.0/24). Leave unset to auto-detect the host's primary /24. Set this
# when auto-detect picks the wrong interface — e.g. inside Docker, or on a host
# with multiple subnets.
# TAPO_DISCOVERY_CIDR=192.168.1.0/24

# Immich. BASE_URL must include the /api suffix. API_KEY is comma-separated —
# one key per phone/user; the script downloads each user's "Birds" album.
IMMICH_BASE_URL=http://192.168.1.50:2283/api
IMMICH_API_KEY=replace-me,replace-me

# Ollama (natural-language commands + chat + vision captioning). This project
# NEVER installs or manages Ollama — it only talks to the one already running on
# the machine. Point OLLAMA_BASE_URL at it. The two models default to ones the
# host already has pulled: a language model for intent/chat and a vision model
# for describing bird photos. Set OLLAMA_ENABLED=0 to turn the AI features off.
OLLAMA_ENABLED=1
# One endpoint for both a direct Ollama AND an Olla load balancer (Olla is an
# Ollama-compatible proxy that spreads calls across several machines, keeping the
# local 8GB GPU for YOLO). For a single Ollama use http://host:11434; for Olla
# use its Ollama path, e.g. http://host:40114/olla/ollama.
OLLAMA_BASE_URL=http://localhost:11434
# With a cluster behind Olla, raise vision concurrency so calls fan out across
# machines instead of queuing on one GPU (default 1 suits a single GPU):
# OLLAMA_VISION_CONCURRENCY=4
# Use an INSTRUCT model here, not a reasoning one: a reasoning model (e.g. qwen3)
# burns its token budget "thinking" and returns empty chat replies, or leaks the
# reasoning into the answer. gemma3:4b answers directly and routes intents just as well.
OLLAMA_LLM_MODEL=gemma3:4b
# Vision model. On a SINGLE 8GB GPU use qwen2.5vl:3b (2.16GB) — the 7B (4.75GB)
# spills to CPU once YOLO + the LLM are also resident. But when the VLM is served
# by an Olla CLUSTER (OLLAMA_BASE_URL points at Olla), it isn't on the local GPU at
# all, so prefer qwen2.5vl:7b — it writes much richer, more accurate memory scenes.
OLLAMA_VLM_MODEL=qwen2.5vl:7b
# Bigger model for COMPLEX memory recall (day/week summaries, "who was most
# active", "any bird didn't eat"). A 4B model confabulates over the per-bird
# tallies; 12B is markedly more accurate. Intent/chat stay on the small LLM above.
# Falls back to OLLAMA_LLM_MODEL if this model is unavailable on the cluster.
OLLAMA_RECALL_MODEL=gemma3:12b
# Max concurrent vision (image) calls; extra callers queue. 1 stops the GPU
# being swamped when many frames are captioned/named at once. Raise if your GPU
# can handle parallel vision passes.
OLLAMA_VISION_CONCURRENCY=1
# How long a worker keeps a model loaded after a request ("30m", "1h", "-1" =
# forever). The server's calls are sporadic (a chat turn, a 5-minute memory
# beat), so Ollama's 5m default means nearly every call pays a cold model load
# first. Raise it when the workers have RAM to spare; default 30m.
# OLLAMA_KEEP_ALIVE=30m
# Per-request read timeout in seconds (default 120). Interactive paths use
# tighter internal caps (intent 45s, chat 90s); this bounds the long ones
# (vision analysis, recall). Availability is handled separately: a DOWN cluster
# fails instantly (health-gated) and the work is queued + replayed on recovery.
# OLLAMA_TIMEOUT_SECONDS=120

# Caretaker reports: the server checks activity often, reports a NEW bird
# immediately, and on this ~N-minute beat edits the last message in place when
# nothing changed (no spam). Every report is also written to the day's memory
# under data/server/memories/YYYY-MM-DD.md, which /activity and "what did percy
# do today?" read back. 0 disables. When reports are ON, raw per-detection photo
# alerts default OFF (set RAW_PHOTO_ALERTS to force). Detections are still
# collected to disk regardless.
MEMORY_INTERVAL_MINUTES=5
# RAW_PHOTO_ALERTS=0

# /find PTZ patrol scans a grid of each pan-tilt camera's range so it covers the
# tilt (up/down) axis too, not just left-right. Columns x rows = cells visited.
PTZ_SCAN_COLS=4
PTZ_SCAN_ROWS=3

# Location (decimal degrees) for sunrise/sunset and the weather outlook. Set these
# to YOUR coordinates — they stay in this local .env and never in the repo. Without
# them, sunrise/sunset fall back to clock anchors and the weather feature stays off.
# The values below are a placeholder (London), NOT a real deployment location.
# AVIARY_LATITUDE=51.5074
# AVIARY_LONGITUDE=-0.1278
# UTC offset (hours) for sunrise/sunset local times; 0 = UTC, no DST. London = 0.
# AVIARY_UTC_OFFSET_HOURS=0

# Weather outlook + bird-safety warnings (Open-Meteo — free, no API key; only the
# coordinates above are sent). Polls a few times a day and warns when the day's
# high or the night's low crosses the bird-safe thresholds (°C); /weather (or
# "what's the weather") gives an on-demand summary. On by default once a location
# is set. Thresholds suit tropical cage birds (cockatiels/lovebirds/budgies).
# WEATHER_ALERTS=0
# WEATHER_HOT_C=32
# WEATHER_COLD_C=10

# Sleep tracker: watches the cameras' IR light cycle to record each night's dark
# window and score the flock's sleep (10-12h target + schedule consistency +
# disturbances). Always on — ask "/sleep" (or "how did the birds sleep?") for the
# report, and /status shows a night-in-progress line. Set SLEEP_MORNING_REPORT=1
# to also push a short "how they slept" summary each morning when they wake.
# SLEEP_MORNING_REPORT=1

# RGB LED status display (lib.rgb): drive the motherboard / RGB header / addressable
# strip LEDs to mirror the aviary's state in real time — a white loading-wave while
# /discover sweeps the network, each bird's signature color (with its own animation)
# when it's seen, and a single LED that glows the night species' color while the
# cameras are in IR. Off by default. Needs a running OpenRGB SDK server — run
# ./scripts/install-rgb.sh once to set it up (OpenRGB + udev + a systemd user service). Control
# it live with /rgb (e.g. "/rgb red 10m", "/rgb auto"); map LEDs to birds with
# `uv run rgb-calibrate`.
# RGB_ENABLED=1
# RGB_HOST=127.0.0.1
# RGB_PORT=6742
# RGB_BRIGHTNESS=1.0
# RGB_STRIP_LEN=-1       # addressable header pixels: -1 leave as detected, 0 disable it, N set N
# RGB_NIGHT_LED=-1       # which LED is the night LED (-1 = auto = last LED)

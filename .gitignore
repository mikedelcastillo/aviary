.env
.DS_Store

# All persistent data (collected frames, snapshots, annotation, training,
# models) lives here so it can be backed up or moved as a single folder.
/data/

# Ultralytics' default run dir, in case a command writes here instead of
# data/training/runs (e.g. val/predict/export without an explicit project).
/runs/

# Immich import working dir (thumbnail cache, manifests, scan state). Local
# runtime output only — large and machine-specific.
/models/

# Server logfile (native FFmpeg/h264 noise + full log; AVIARY_LOG_FILE).
aviary.log

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

.next

# Model artifacts are large.
*.pt
*.onnx
*.engine
*.tflite

.claude

# Superpowers brainstorming visual-companion mockups (local, ephemeral).
.superpowers/

# local-only: research papers + scratch drivers
ghiasi.pdf
ghiasi.txt
_*.sh
